{
  "name": "livedocs",
  "version": "0.1.0",
  "private": true,
  "description": "CLI that prints shadcn install commands for the livedocs registry",
  "type": "module",
  "bin": {
    "livedocs": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frostui/registry": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
}
