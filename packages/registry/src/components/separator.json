{
  "name": "separator",
  "title": "Separator",
  "category": "foundations",
  "description": "Horizontal or vertical divider between sections.",
  "dependencies": ["@radix-ui/react-separator"],
  "registryDependencies": ["utils"],
  "files": ["registry/frostui/ui/separator.tsx"],
  "examples": ["horizontal", "vertical"],
  "variants": ["default"],
  "keywords": ["separator", "divider", "hr", "border"],
