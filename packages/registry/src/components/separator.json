    { "name": "orientation", "type": "\"horizontal\" | \"vertical\"", "default": "\"horizontal\"", "description": "Divider direction" },
    { "name": "decorative", "type": "boolean", "default": "true", "description": "Whether the separator is purely decorative" }
  ],
  "ai": {
    "purpose": "Visually separate related content groups.",
    "useWhen": [
      "Section breaks in settings",
      "Sidebar group dividers",
      "Inline toolbar separators"
    ],
    "preferOver": [
      "Empty div borders for simple dividers",
      "Multiple br tags for spacing"
    ],
    "avoid": [
      "Separators when whitespace alone is enough",
      "Overusing vertical separators in dense layouts"
    ],
    "compositions": [
      "Separator between Card sections",
      "Separator in sidebar navigation",
      "Separator + stacked text blocks"
    ]
  }
