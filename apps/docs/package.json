{
  "name": "@frostui/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @frostui/registry build:registry && next dev --port 3000",
    "build": "pnpm --filter @frostui/registry build:registry && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@frostui/registry": "workspace:*",
    "@frostui/ui": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.10",
