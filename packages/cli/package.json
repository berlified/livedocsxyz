{
  "name": "frostui",
  "version": "0.1.0",
  "private": true,
  "description": "CLI to add FrostUI components to your project",
  "type": "module",
  "bin": {
    "frostui": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frostui/registry": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
