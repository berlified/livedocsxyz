{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "frostui",
  "homepage": "https://livedocs.xyz",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Theme",
      "description": "FrostUI semantic tokens — dark-first, high-contrast surfaces.",
      "files": [
        {
          "path": "registry/frostui/style/theme.css",
          "type": "registry:theme",
          "target": "app/globals.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "Tailwind class merge helper used by all FrostUI components.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "apps/docs/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Action button with default, secondary, outline, ghost, destructive, and link variants.",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "apps/docs/components/ui/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "Compact status label for counts, states, and metadata.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "apps/docs/components/ui/badge.tsx",
          "type": "registry:ui",
          "target": "components/ui/badge.tsx"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "Layered surface for grouped content with header, body, and footer slots.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "apps/docs/components/ui/card.tsx",
          "type": "registry:ui",
          "target": "components/ui/card.tsx"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "Single-line text field with focus ring and disabled states.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "apps/docs/components/ui/input.tsx",
          "type": "registry:ui",
          "target": "components/ui/input.tsx"
        }
      ]
    },
    {
      "name": "avatar",
      "type": "registry:ui",
      "title": "Avatar",
      "description": "User or entity identity with image and fallback initials.",
      "dependencies": ["@radix-ui/react-avatar"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "apps/docs/components/ui/avatar.tsx",
          "type": "registry:ui",
          "target": "components/ui/avatar.tsx"
        }
      ]
    },
    {
      "name": "separator",
      "type": "registry:ui",
      "title": "Separator",
      "description": "Horizontal or vertical divider between sections.",
      "dependencies": ["@radix-ui/react-separator"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "apps/docs/components/ui/separator.tsx",
          "type": "registry:ui",
          "target": "components/ui/separator.tsx"
        }
      ]
    }
  ]
}
