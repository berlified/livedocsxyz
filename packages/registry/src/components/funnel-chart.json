{
  "name": "funnel-chart",
  "title": "Funnel Chart",
  "description": "Centered stage funnel with step conversion rates and optional interactive stages.",
  "category": "charts",
  "dependencies": [],
  "registryDependencies": [
    "https://livedocs.xyz/r/chart.json",
    "https://livedocs.xyz/r/card.json",
    "https://livedocs.xyz/r/utils.json"
  ],
  "files": ["apps/docs/components/ui/funnel-chart.tsx"],
  "examples": ["growth"],
  "variants": ["default"],
  "keywords": ["chart", "funnel", "conversion", "stages", "acquisition", "dropoff"],
  "props": [
    { "name": "stages", "type": "FunnelStage[]", "description": "key, label, value, meta" },
    { "name": "config", "type": "ChartConfig", "description": "Per-stage color config" },
    { "name": "title", "type": "string", "description": "Card heading" },
    { "name": "description", "type": "string", "description": "Secondary caption" },
    { "name": "showConversion", "type": "boolean", "description": "Step conversion captions" },
    { "name": "onStageClick", "type": "(stage: FunnelStage) => void", "description": "Enables interactive stages" },
    { "name": "emptyLabel", "type": "string", "description": "Empty state message" },
    { "name": "className", "type": "string", "description": "Card class passthrough" }
  ],
  "ai": {
    "purpose": "Show sequential stage volume with conversion between steps.",
    "useWhen": ["Signup to paid flow", "Checkout steps", "Hiring pipeline"],
    "preferOver": ["A pie when order and dropoff matter"],
    "avoid": ["Non-ordered stages", "Many near-equal stages"],
    "compositions": ["FunnelChart beside LaneChart"]
  }
}
