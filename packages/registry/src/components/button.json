{
  "name": "button",
  "title": "Button",
  "category": "foundations",
  "description": "A versatile action button with solid, soft, ghost, surface, and link variants.",
  "dependencies": ["@radix-ui/react-slot", "class-variance-authority", "lucide-react"],
  "registryDependencies": [],
  "files": ["packages/ui/src/components/button.tsx"],
  "examples": ["variant", "color", "semantic", "high-contrast", "size", "loading"],
  "variants": ["solid", "soft", "ghost", "surface", "classic", "outline", "link"],
  "keywords": ["button", "action", "cta", "submit", "click"],
  "props": [
    { "name": "variant", "type": "\"solid\" | \"soft\" | \"ghost\" | \"surface\" | \"classic\" | \"outline\" | \"link\"", "default": "\"solid\"", "description": "Visual style" },
    { "name": "color", "type": "\"blue\" | \"green\" | \"orange\" | \"red\" | \"gray\" | \"info\" | \"success\" | \"warning\" | \"danger\"", "default": "\"blue\"", "description": "Accent color" },
    { "name": "size", "type": "\"1\" | \"2\" | \"3\" | \"4\" | \"icon\" | \"icon-3\" | \"icon-4\"", "default": "\"2\"", "description": "Control size" },
    { "name": "highContrast", "type": "boolean", "default": "false", "description": "Higher contrast treatment" },
    { "name": "loading", "type": "boolean", "default": "false", "description": "Shows spinner and disables interaction" },
    { "name": "asChild", "type": "boolean", "default": "false", "description": "Render as child via Radix Slot" },
    { "name": "disabled", "type": "boolean", "default": "false", "description": "Disables the button" }
  ],
  "ai": {
    "purpose": "Trigger an action or navigate via composed links.",
    "useWhen": [
      "Primary or secondary actions",
      "Form submissions",
      "Toolbar and dialog footers"
    ],
    "preferOver": [
      "Styled <button> or <a> with ad-hoc Tailwind",
      "Divs with onClick for actions"
    ],
    "avoid": [
      "Using Button for non-interactive text",
      "Nesting interactive elements inside Button"
    ],
    "compositions": [
      "Button + Badge for status actions",
      "Button group in CardFooter",
      "Icon + Button for labeled icon actions"
    ]
  }
}
