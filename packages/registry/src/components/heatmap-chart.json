{
  "name": "heatmap-chart",
  "title": "Heatmap Chart",
  "category": "charts",
  "description": "Keyboard-navigable activity grid with intensity fills, legend scale, and null-safe cells.",
  "dependencies": [],
  "registryDependencies": [
    "https://livedocs.xyz/r/chart.json",
    "https://livedocs.xyz/r/card.json",
    "https://livedocs.xyz/r/button.json",
    "https://livedocs.xyz/r/utils.json"
  ],
  "files": ["apps/docs/components/ui/heatmap-chart.tsx"],
  "examples": ["analytics"],
  "variants": ["default"],
  "keywords": ["chart", "heatmap", "grid", "activity", "matrix", "calendar", "keyboard"],
  "props": [
    { "name": "data", "type": "HeatmapCell[]", "description": "x, y, value (null for missing)" },
    { "name": "columns", "type": "string[]", "description": "Optional explicit column order" },
    { "name": "rows", "type": "string[]", "description": "Optional explicit row order" },
    { "name": "title", "type": "string", "description": "Card heading" },
    { "name": "description", "type": "string", "description": "Secondary caption" },
    { "name": "config", "type": "ChartConfig", "description": "Series color config" },
    { "name": "formatValue", "type": "(value: number) => string", "description": "Cell and legend formatter" },
    { "name": "onCellClick", "type": "(cell: HeatmapCell) => void", "description": "Cell activation callback" },
    { "name": "emptyLabel", "type": "string", "description": "Empty state message" },
    { "name": "className", "type": "string", "description": "Card class passthrough" }
  ],
  "ai": {
    "purpose": "Reveal intensity patterns across two categorical axes with accessible keyboard exploration.",
    "useWhen": ["Engagement by hour/day", "Cohort retention grids", "Inventory density"],
    "preferOver": ["A bar grid when the pattern matters more than exact values"],
    "avoid": ["Continuous axes", "Single-dimension comparisons"],
    "compositions": ["HeatmapChart above TrendCard"]
  }
}
