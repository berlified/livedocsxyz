{
  "name": "livedocs-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "shadcn component registry for livedocs.xyz",
  "scripts": {
    "dev": "pnpm --filter @frostui/registry build:registry && pnpm --filter @frostui/docs dev",
    "build": "pnpm --filter @frostui/registry build:registry && pnpm -r build",
    "build:docs": "pnpm --filter @frostui/registry build:registry && pnpm --filter @frostui/docs build",
    "registry:build": "pnpm --filter @frostui/registry build:registry",
    "registry:validate": "npx shadcn@latest registry validate registry/registry.json",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "license": "MIT"
}
